{
    "manifest_version": 3,
    "name": "Oppenheimer Tooling",
    "version": "0.1.0",
    "permissions": ["tabs", "scripting", "alarms", "storage", "sidePanel", "clipboardWrite"],
    "host_permissions": ["https://*/*"],
    "background": { "service_worker": "background.js", "type": "module" },
    "description": "accessibility tooling.",
    "content_scripts": [
	{
	    "matches": ["https://www.linkedin.com/search/results/*"],
	    "js": ["linkedin-search-content.js"],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/sales/search/people*"],
	    "js": [
		"lead-search-content.js"
	    ],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/company/*"],
	    "js": ["profile-content.js"],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/company/*"],
	    "js": ["profile-company-content.js"],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/in/*"],
	    "js": ["profile-person-content.js"],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/mynetwork/invitation-manager/sent*"],
	    "js": ["invitations-content.js"],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/sales/search/company*"],
	    "js": ["account-search-content.js"],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/sales/company/*"],
	    "js": ["lsn-profile-content.js"],
	    "run_at": "document_idle"
	},
	{
	    "matches": ["https://www.linkedin.com/sales/lead/*"],
	    "js": ["lsn-lead-profile-content.js"],
	    "run_at": "document_idle"
	}
    ],
    "side_panel": {
	"default_path": "sidepanel.html"
    },
    "action": {
	
    }
}
